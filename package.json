{
  "name": "targetdata",
  "packageManager": "bun@1.4.4",
  "version": "0.1.0",
  "description": "Unofficial TypeScript SDK for the TargetData API: credit, compliance, vehicle and people lookups for Brazil",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run build"
  },
  "keywords": [
    "targetdata",
    "smart",
    "api-client",
    "typescript",
    "cpf",
    "cnpj",
    "credit",
    "compliance",
    "veiculos"
  ],
  "author": "Gustavo Salomé (gusnips)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gusnips/targetdata.git"
  },
  "bugs": {
    "url": "https://github.com/gusnips/targetdata/issues"
  },
  "homepage": "https://github.com/gusnips/targetdata#readme",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@gusnips/oxlint": "^0.2.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.5",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tsdown": "0.23.7",
    "typescript": "^7.0.2"
  }
}
